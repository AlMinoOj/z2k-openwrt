#!/bin/sh /etc/rc.common
# z2k-openwrt: обход DPI (zapret2 + z2k).
#
# Обёртка над движком z2k — /opt/zapret2/init.d/z2k-engine (это
# files/S99zapret2.new апстрима + платформенный слой openwrt/lib/s99-openwrt.sh).
# Вся логика старта/остановки, Lua-цепочка, кэш ротации и исключения живут в
# движке и приезжают с апстримом без ручного переноса; здесь — только
# интеграция с rc.common (enable/disable, автозапуск, команды).

START=99
STOP=10

ENGINE=/opt/zapret2/init.d/z2k-engine

EXTRA_COMMANDS="status start_fw stop_fw restart_fw start_daemons stop_daemons restart_daemons reload_ifsets list_ifsets list_table debug_rotate"
EXTRA_HELP="	status          Состояние демонов nfqws2
	start_fw        Поставить правила nftables
	stop_fw         Снять правила nftables
	restart_fw      Переставить правила nftables
	start_daemons   Запустить только демоны
	stop_daemons    Остановить только демоны
	restart_daemons Перезапустить только демоны
	reload_ifsets   Обновить наборы WAN/LAN-интерфейсов (после ifup/ifdown)
	list_ifsets     Показать наборы интерфейсов
	list_table      Показать таблицу nftables zapret2
	debug_rotate    Обрезать отладочный лог, если перерос потолок"

engine()
{
	[ -x "$ENGINE" ] || { echo "z2k: движок не установлен ($ENGINE)"; return 1; }
	"$ENGINE" "$@"
}

# Изменяющие действия — по одному. Их зовут cron (сторож, списки), панель,
# обновлятор и hotplug, и два одновременных перезапуска оставляли nfqws2-сироту
# без pidfile: он держал очередь, и новый демон не стартовал
# (nfq_create_queue: Operation not permitted). flock в busybox OpenWrt не
# всегда есть — замок каталогом, протухший (держатель умер) снимается.
LOCKD=/var/run/z2k-init.lock
z2k_lock()
{
	local i=0 p
	while ! mkdir "$LOCKD" 2>/dev/null; do
		p=$(cat "$LOCKD/pid" 2>/dev/null)
		if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$LOCKD"; continue; fi
		i=$((i + 1))
		[ "$i" -ge 120 ] && { echo "z2k: другое действие со службой не закончилось за 120 с"; return 1; }
		sleep 1
	done
	echo $$ > "$LOCKD/pid"
}
locked()
{
	local rc
	z2k_lock || return 1
	engine "$@"; rc=$?
	rm -rf "$LOCKD"
	return $rc
}

start()           { locked start; }
stop()            { locked stop; }
restart()         { locked restart; }
status()          { engine status; }
start_fw()        { locked start_fw; }
stop_fw()         { locked stop_fw; }
restart_fw()      { locked restart_fw; }
start_daemons()   { locked start_daemons; }
stop_daemons()    { locked stop_daemons; }
restart_daemons() { locked restart_daemons; }
reload_ifsets()   { locked reload_ifsets; }
list_ifsets()     { engine list_ifsets; }
list_table()      { engine list_table; }
debug_rotate()    { engine debug_rotate; }
