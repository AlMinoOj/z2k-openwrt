#!/bin/sh /etc/rc.common
# z2k-openwrt: мост к RuTracker (модуль rtproxy).
#
# Аналог files/init.d/S96z2k-rt-proxy апстрима:
#   * домены RuTracker резолвятся в «маячок» 10.171.171.171 — на Keenetic это
#     `ndmc ip host`, здесь записи `config domain` в UCI dnsmasq (видны в LuCI,
#     снимаются при остановке);
#   * TCP:443 к маячку заворачивается nftables на :1445, где z2k-rt-proxy
#     читает SNI и ведёт соединение через пул HTTPS-CONNECT прокси.
# PPE-разгрузка Keenetic не нужна: перехваченный трафик идёт на сам роутер и
# flow offload его не касается.

START=96
STOP=14
USE_PROCD=1

BIN=/opt/sbin/z2k-rt-proxy
LOG=/tmp/z2k-log/z2k-rt-proxy.log
PORT=1445
SENTINEL=10.171.171.171
DOMAINS="rutracker.org rutracker.wiki api.rutracker.cc rep.rutracker.cc static.rutracker.cc"
TABLE=z2k_rtproxy

dns_set()
{
	local d n
	for d in $DOMAINS; do
		n="z2k_rt_$(echo "$d" | tr '.-' '__')"
		uci -q batch <<EOF
set dhcp.$n=domain
set dhcp.$n.name='$d'
set dhcp.$n.ip='$SENTINEL'
EOF
	done
	uci -q commit dhcp
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
}

dns_clear()
{
	local s changed=""
	for s in $(uci -q show dhcp | sed -n "s/^dhcp\.\(z2k_rt_[a-z0-9_]*\)=domain$/\1/p"); do
		uci -q delete "dhcp.$s" && changed=1
	done
	[ -n "$changed" ] && { uci -q commit dhcp; /etc/init.d/dnsmasq reload >/dev/null 2>&1; }
	return 0
}

redirect_add()
{
	nft -f - <<EOF
table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
	chain prerouting {
		type nat hook prerouting priority dstnat - 5; policy accept;
		ip daddr $SENTINEL tcp dport 443 redirect to :$PORT comment "z2k: rutracker -> rt-proxy"
	}
	chain output {
		type nat hook output priority -105; policy accept;
		ip daddr $SENTINEL tcp dport 443 redirect to :$PORT
	}
}
EOF
}

redirect_del() { nft delete table inet $TABLE 2>/dev/null; return 0; }

start_service()
{
	[ -x "$BIN" ] || return 0
	mkdir -p /tmp/z2k-log && chmod 700 /tmp/z2k-log

	procd_open_instance rtproxy
	procd_set_param command /bin/sh -c "exec $BIN --listen=:$PORT --timeout=15m >>$LOG 2>&1"
	procd_set_param env GODEBUG=asyncpreemptoff=1
	procd_set_param respawn 3600 5 0
	procd_close_instance

	redirect_add
	dns_set
}

stop_service()
{
	redirect_del
	dns_clear
}
