#!/bin/sh /etc/rc.common
# z2k-openwrt: Телеграм-туннель (модуль tg).
#
# tg-mtproxy-client — прозрачный мультиплексор TCP поверх WebSocket до relay
# (MTProto внутри нет). Слушает :1443 (дата-центры Telegram) и :1444 (CDN);
# трафик туда заворачивают правила nftables (z2k-tg-redirect.sh).
#
# Аналог files/init.d/S98tg-tunnel апстрима: самописный супервизор заменён
# procd (respawn с паузой). Relay по умолчанию — вшитый в сборку апстрима;
# свой задаётся в /opt/zapret2/config: Z2K_RELAY_URL, Z2K_RELAY_SECRET.
# Выключатель панели/меню — TG_PROXY_USER_DISABLED=1.

START=98
STOP=12
USE_PROCD=1

BIN=/opt/sbin/tg-mtproxy-client
CONF=/opt/zapret2/config
LIB=/opt/zapret2/z2k-tg-redirect.sh
LOG=/tmp/z2k-log/tg-tunnel.log

conf_get() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | head -n 1 | tr -d "\"' "; }

start_service()
{
	[ -x "$BIN" ] || return 0
	[ "$(conf_get TG_PROXY_USER_DISABLED)" = 1 ] && { echo "tg-tunnel выключен в настройках"; return 0; }

	mkdir -p /tmp/z2k-log && chmod 700 /tmp/z2k-log

	local secret url args
	secret=$(conf_get Z2K_RELAY_SECRET); url=$(conf_get Z2K_RELAY_URL)
	args="--listen=:1443 --listen=:1444 --timeout=15m -v"
	[ -n "$secret" ] && args="$args --tunnel-secret=$secret"
	[ -n "$url" ] && args="$args --tunnel-url=$url"

	procd_open_instance tg
	# Лог — в файл, как у апстрима (его читают сторож и диагностика z2k).
	procd_set_param command /bin/sh -c "exec $BIN $args >>$LOG 2>&1"
	# MIPS: без этого Go-рантайм ловит асинхронную вытесняющую остановку.
	procd_set_param env GODEBUG=asyncpreemptoff=1 SSL_CERT_FILE=/opt/zapret2/etc/z2k-roots.pem SSL_CERT_DIR=/etc/ssl/certs
	# Пауза 5 с перед перезапуском, бесконечно (сторож следит за качеством).
	procd_set_param respawn 3600 5 0
	procd_close_instance

	[ -r "$LIB" ] && . "$LIB" && z2k_tg_ensure_rules && z2k_tg_flush_conntrack
}

stop_service()
{
	[ -r "$LIB" ] && . "$LIB" && z2k_tg_remove_rules
}

service_triggers()
{
	procd_add_reload_trigger z2k-tg
}
